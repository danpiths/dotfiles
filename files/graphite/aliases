# Edit this file to configure aliases for Graphite commands.
# If you delete this file, it will be recreated with the default aliases.
# The first word of each line is the alias, and the rest is the command.
# Lines starting with # are ignored.

# The aliases for ss, ls, and ll are defined by default and must be overridden to be disabled.
# They are shown below to demonstrate the formatting.

# pre commit
a add

# create
cp create --patch

# modify
mp modify --patch
mpe modify --patch --edit
abd absorb --dry-run
ab absorb --patch
sp split --hunk
sq squash --no-edit
r restore --staged .
r! restore .

# delete
x delete
xf delete --force

# rebasing
cn continue

# traversal
b bottom
d down
co checkout
coa checkout --all
cos checkout --stack
cou checkout --show-untracked
cot checkout --trunk

# display info
ls log short
ll log long
i info
ip info --patch
id info --diff
ips info --patch --stat
ids info --diff --stat

# review
rw review

# submit current PR
s submit --ai --cli --confirm --rerequest-review -r akshaydeo
se submit --ai --cli --confirm --rerequest-review -r akshaydeo --edit
sed submit --ai --cli --confirm --rerequest-review -r akshaydeo --edit-description

# submit current PR (drafted)
sd submit --ai --cli --confirm --rerequest-review -r akshaydeo --draft
sde submit --ai --cli --confirm --rerequest-review -r akshaydeo --draft --edit
sded submit --ai --cli --confirm --rerequest-review -r akshaydeo --draft --edit-description

# submit stack
ss submit --ai --cli --confirm --rerequest-review -r akshaydeo --stack --confirm
sse submit --ai --cli --confirm --rerequest-review -r akshaydeo --stack --confirm --edit
ssed submit --ai --cli --confirm --rerequest-review -r akshaydeo --stack --confirm --edit-description

# submit stack (drafted)
ssd submit --ai --cli --confirm --rerequest-review -r akshaydeo --stack --draft --confirm
ssde submit --ai --cli --confirm --rerequest-review -r akshaydeo --stack --draft --confirm --edit
ssded submit --ai --cli --confirm --rerequest-review -r akshaydeo --stack --draft --confirm --edit-description
